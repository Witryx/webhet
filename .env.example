NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set true only after business/legal review and production domain verification.
SITE_INDEXABLE=false
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional public fallback; never put private credentials in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CONTACT_EMAIL=
# Recommended for shared rate limiting on serverless production (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
